    "@iconify-icons/tabler": "2.0.4",
    "@iconify/types": "2.0.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@oomol-lab/open-flow": "0.1.0-beta.62",
    "@oomol/connection": "0.2.28",
    "@oomol/connection-electron-adapter": "0.2.12",
    "@opencode-ai/plugin": "1.19.4",
    "@shikijs/langs": "4.5.0",
    "@shikijs/themes": "4.5.0",
    "@streamdown/mermaid": "1.0.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/js-yaml": "4.0.9",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/yazl": "3.3.1",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@univerjs/core": "1.2.0",
    "@univerjs/preset-sheets-core": "1.2.0",
    "@vitejs/plugin-react": "6.1.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "docx-preview": "0.4.1",
    "effect": "4.0.0-rc.112",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "franc-min": "6.2.0",
    "happy-dom": "21.0.4",
    "js-yaml": "5.5.0",
    "jszip": "3.10.2",
    "lucide-react": "1.61.0",
    "motion": "14.6.0",
    "opencode-ai": "1.19.4",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "pdfjs-dist": "6.4.299",
    "plist": "5.0.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "read-excel-file": "9.3.12",
    "rolldown": "1.2.15",
    "rxjs": "7.8.2",
    "shiki": "4.5.0",
    "sonner": "2.0.8",
    "streamdown": "2.7.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tar": "7.5.22",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "use-stick-to-bottom": "1.1.6",
    "vite": "8.3.5",
    "vite-plugin-electron": "1.1.2",
    "vitest": "5.0.5",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61"
}

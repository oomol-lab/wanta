{
  "name": "wanta",
  "displayName": "Wanta",
  "version": "0.0.0",
  "private": true,
  "description": "Wanta — open-source desktop AI agent for connected apps, local files, and automation.",
  "homepage": "https://wanta.ai/",
  "bugs": {
    "url": "https://github.com/oomol-lab/wanta/issues"
  },
  "license": "Apache-2.0",
  "author": "OOMOL",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oomol-lab/wanta.git"
  },
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "bootstrap": "node --experimental-strip-types ./scripts/bootstrap.ts",
    "auth:capture": "node --experimental-strip-types ./scripts/dev-auth-state.ts capture",
    "auth:save": "node --experimental-strip-types ./scripts/dev-auth-state.ts save",
    "auth:restore": "node --experimental-strip-types ./scripts/dev-auth-state.ts restore",
    "auth:clean": "node --experimental-strip-types ./scripts/dev-auth-state.ts clean",
    "auth:status": "node --experimental-strip-types ./scripts/dev-auth-state.ts status",
    "oo:verify": "node --experimental-strip-types ./scripts/oo-skill-lock.ts",
    "oo:upgrade": "node --experimental-strip-types ./scripts/oo-upgrade.ts",
    "postinstall": "node --experimental-strip-types ./scripts/download-electron.ts && node --experimental-strip-types ./scripts/download-oo.ts && node --experimental-strip-types ./scripts/download-spaces.ts && node --experimental-strip-types ./scripts/download-skills.ts && node --experimental-strip-types ./scripts/download-ripgrep.ts && node --experimental-strip-types ./scripts/download-lark-cli.ts && node --experimental-strip-types ./scripts/download-wecom-cli.ts && node --experimental-strip-types ./scripts/download-dingtalk-cli.ts && node --experimental-strip-types ./scripts/build-agent-tool-runtime.ts",
    "predev": "node --experimental-strip-types ./scripts/check-oo.ts",
    "dev": "node --experimental-strip-types ./scripts/dev.ts",
    "dev:worktree": "node --experimental-strip-types ./scripts/dev-worktree.ts",
    "dev:no-electron": "vite --mode no-electron",
    "build": "pnpm run build:app",
    "ts-check": "tsgo -p tsconfig.json --incremental false",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "test": "vitest run",
    "build:app": "pnpm run i18n:check && pnpm run ts-check && vite build",
    "prepare:binaries": "node --experimental-strip-types scripts/prepare-binaries.ts",
    "build:electron": "pnpm run build:app && pnpm run prepare:binaries && electron-builder --publish never",
    "build:mac": "pnpm run build:app && pnpm run prepare:binaries && electron-builder --mac --publish never",
    "build:win": "pnpm run build:app && pnpm run prepare:binaries && electron-builder --win --publish never",
    "build:linux": "pnpm run build:app && pnpm run prepare:binaries && electron-builder --linux --publish never",
    "i18n:check": "vitest run src/i18n/catalog.test.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.102",
    "@ai-sdk/openai-compatible": "3.0.78",
    "@opencode-ai/sdk": "1.19.4",
    "ai": "7.0.153",
    "diff": "9.0.0",
    "electron-updater": "6.8.11",
    "playwright-core": "1.64.1",
    "react-diff-view": "3.3.3",
    "yazl": "3.3.1"
  },

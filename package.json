{
  "name": "wanta",
  "displayName": "Wanta",
  "version": "0.0.0",
  "private": true,
  "description": "Wanta — open-source desktop AI agent for connected apps, local files, and automation.",
  "homepage": "https://wanta.ai/",
  "bugs": {
    "url": "https://github.com/oomol-lab/wanta/issues"
  },
  "license": "Apache-2.0",
  "author": "OOMOL",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oomol-lab/wanta.git"
  },
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "bootstrap": "node --experimental-strip-types ./scripts/bootstrap.ts",
    "auth:capture": "node --experimental-strip-types ./scripts/dev-auth-state.ts capture",
    "auth:save": "node --experimental-strip-types ./scripts/dev-auth-state.ts save",
    "auth:restore": "node --experimental-strip-types ./scripts/dev-auth-state.ts restore",
    "auth:clean": "node --experimental-strip-types ./scripts/dev-auth-state.ts clean",
    "auth:status": "node --experimental-strip-types ./scripts/dev-auth-state.ts status",
    "oo:verify": "node --experimental-strip-types ./scripts/oo-skill-lock.ts",
    "oo:upgrade": "node --experimental-strip-types ./scripts/oo-upgrade.ts",
    "postinstall": "node --experimental-strip-types ./scripts/download-electron.ts && node --experimental-strip-types ./scripts/download-oo.ts && node --experimental-strip-types ./scripts/download-skills.ts && node --experimental-strip-types ./scripts/download-ripgrep.ts && node --experimental-strip-types ./scripts/download-lark-cli.ts && node --experimental-strip-types ./scripts/download-wecom-cli.ts && node --experimental-strip-types ./scripts/download-dingtalk-cli.ts && node --experimental-strip-types ./scripts/build-agent-tool-runtime.ts",
    "predev": "node --experimental-strip-types ./scripts/check-oo.ts",
    "dev": "node --experimental-strip-types ./scripts/dev.ts",
    "dev:worktree": "node --experimental-strip-types ./scripts/dev-worktree.ts",
    "dev:no-electron": "vite --mode no-electron",
    "build": "pnpm run build:app",
    "ts-check": "tsgo -p tsconfig.json --incremental false",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "test": "vitest run",
    "build:app": "pnpm run ts-check && vite build",
    "prepare:binaries": "node --experimental-strip-types scripts/prepare-binaries.ts",
    "build:electron": "pnpm run build:app && pnpm run prepare:binaries && electron-builder --publish never",
    "build:mac": "pnpm run build:app && pnpm run prepare:binaries && electron-builder --mac --publish never",
    "build:win": "pnpm run build:app && pnpm run prepare:binaries && electron-builder --win --publish never",
    "build:linux": "pnpm run build:app && pnpm run prepare:binaries && electron-builder --linux --publish never"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.46",
    "@ai-sdk/openai-compatible": "3.0.35",
    "@opencode-ai/sdk": "1.18.21",
    "ai": "7.0.77",
    "diff": "9.0.0",
    "electron-updater": "6.8.9",
    "playwright-core": "1.62.1",
    "react-diff-view": "3.3.3",
    "unbash": "4.0.10",
    "wiki-graph": "0.5.0",
    "wiki-graph-core": "0.5.0"
  },
  "devDependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.70.0",
    "@agentclientprotocol/codex-acp": "1.6.2",
    "@agentclientprotocol/sdk": "^1.4.0",
    "@electron-internal/extract-zip": "1.0.5",
    "@electron/get": "5.1.0",
    "@iconify-icons/simple-icons": "2.0.0",
    "@iconify-icons/tabler": "2.0.0",
    "@iconify/types": "2.0.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@oomol/connection": "0.2.28",
    "@oomol/connection-electron-adapter": "0.2.12",
    "@opencode-ai/plugin": "1.18.21",
    "@shikijs/langs": "4.4.3",
    "@shikijs/themes": "4.4.3",
    "@streamdown/mermaid": "1.0.2",
    "@tailwindcss/vite": "4.3.3",
    "@types/js-yaml": "4.0.9",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@univerjs/core": "0.25.1",
    "@univerjs/preset-sheets-core": "0.25.1",
    "@vitejs/plugin-react": "6.1.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "docx-preview": "0.4.0",
    "electron": "43.4.1",
    "electron-builder": "26.15.3",
    "franc-min": "6.2.0",
    "happy-dom": "20.11.6",
    "js-yaml": "5.3.0",
    "jszip": "3.10.1",
    "lucide-react": "1.33.0",
    "motion": "13.1.1",
    "opencode-ai": "1.18.21",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "pdfjs-dist": "6.2.108",
    "plist": "5.0.0",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "read-excel-file": "9.3.10",
    "rolldown": "1.2.5",
    "rxjs": "7.8.2",
    "shiki": "4.4.3",
    "sonner": "2.0.8",
    "streamdown": "2.5.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "tar": "7.5.22",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "use-stick-to-bottom": "1.1.6",
    "vite": "8.2.2",
    "vite-plugin-electron": "1.1.1",
    "vitest": "4.1.11",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "packageManager": "pnpm@11.23.0"
}
